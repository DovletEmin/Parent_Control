# Application
APP_NAME=mSpy
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
API_V1_PREFIX=/api/v1

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL
POSTGRES_USER=mspy
POSTGRES_PASSWORD=mspy_secret
POSTGRES_DB=mspy_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MinIO
MINIO_ROOT_USER=mspy_minio
MINIO_ROOT_PASSWORD=mspy_minio_secret
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=mspy-media
MINIO_SECURE=false

# FCM (Firebase Cloud Messaging)
FCM_CREDENTIALS_PATH=
